    "Accept a sequence of five single digit numbers seperated by commas as input.print the product of all five numbers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "7d5b53de-18c1-4f15-9857-69324c70650d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter five digits separated by commas:  55,63,47,81,10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Product: 131912550\n"
     ]
    }
   ],
   "source": [
    "numbers = input(\"Enter five digits separated by commas: \")\n",
    "\n",
    "numbers = numbers.split(\",\")\n",
    "\n",
    "product = 1\n",
    "\n",
    "for num in numbers:\n",
    "    product *= int(num)\n",
    "\n",
    "print(\"Product:\", product)\n"
   ]
  },
